source "https://rubygems.org"

# Use the GitHub Pages Jekyll series without installing unused themes/plugins.
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm", "~> 1.1"
gem "jekyll-feed", "~> 0.15"
gem "jekyll-redirect-from", "~> 0.16"
gem "jekyll-sitemap", "~> 1.4"

# Ruby 3 no longer bundles WEBrick; Windows needs a timezone database.
gem "webrick", "~> 1.8"
gem "tzinfo-data" if Gem.win_platform?
